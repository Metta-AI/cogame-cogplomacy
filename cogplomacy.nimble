version     = "0.1.0"
author      = "daveey"
description = "Cogplomacy: Allan Calhamer's Diplomacy for the Softmax Coworld platform. Seven cogs, the 1901 map of Europe, simultaneous orders and non-binding press; a policy is just a prompt."
license     = "MIT"

srcDir = "src"

requires "nim >= 2.2.4"
requires "bitworld >= 0.1.0"
requires "mummy >= 0.4.7"
requires "curly >= 1.1.1"
requires "whisky"
